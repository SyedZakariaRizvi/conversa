<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing.css">
  <title>Conversa</title>
</head>
<body>
  <main class="landing-page">
    <header class="topbar">
      <div class="brand">Conversa</div>
      <nav class="nav-links">
        <a href="/login" class="nav-link">Login</a>
        <a href="/register" class="nav-link nav-link-primary">Sign up</a>
      </nav>
    </header>

    <section class="hero">
      <p class="badge">Simple Real-time Chat</p>
      <h1>Talk to friends without extra clutter.</h1>
      <p class="hero-copy">
        Conversa is a straightforward one-to-one chat app built for speed, simple UX, and easy communication.
      </p>
      <div class="hero-actions">
        <a href="/register" class="button button-primary">Create account</a>
        <a href="/login" class="button button-ghost">I already have an account</a>
      </div>
    </section>

    <section class="feature-grid">
      <article class="feature-card">
        <h2>Real-time Messaging</h2>
        <p>Send and receive messages instantly with Socket.IO powered updates.</p>
      </article>
      <article class="feature-card">
        <h2>Clean Dashboard</h2>
        <p>Chat sidebar, active conversation panel, and focused controls.</p>
      </article>
      <article class="feature-card">
        <h2>Secure Sign-in</h2>
        <p>User sessions and password hashing handled by Passport and bcrypt.</p>
      </article>
    </section>
  </main>
</body>
</html>
